{
  "model_type": "pi05_force",
  "base_checkpoint": "models/pi05_sft",
  "tokenizer": "models/tokenizer",
  "dataset_windows": "outputs/force_vla_31d_windows/windows.parquet",
  "conditioning_layout": "separate",
  "state_dim": 10,
  "torque_dim": 7,
  "torque_history_steps": 10,
  "future_steps": 50,
  "max_action_dim": 32,
  "action_dim": 10,
  "future_torque_loss_weight": 0.1,
  "use_external_torque": false,
  "training": {
    "initialize_from_pi05": true,
    "freeze_vision_encoder": true,
    "train_expert_only": false,
    "trainable": "lora",
    "lora_rank": 16,
    "lora_alpha": 16.0,
    "lora_expert_rank": 32,
    "lora_expert_alpha": 32.0,
    "critical_sample_fraction": 0.25,
    "phase_balanced_evaluation": true,
    "steps": 30000,
    "seed": 42,
    "validation_every": 1000,
    "validation_windows_per_episode": 16,
    "save_every": 1000,
    "gradient_checkpointing": true,
    "compile_model": false,
    "dtype": "bfloat16",
    "learning_rate": 0.00001,
    "batch_size": 4
  }
}
